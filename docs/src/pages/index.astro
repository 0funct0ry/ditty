---
// The marketing homepage — a faithful build of internal-docs/MARKETING-MOCKUP.html,
// not a Starlight page, so it isn't wrapped in the docs chrome (sidebar/TOC).
// Links point at the real docs routes; everything else is the mockup as-is.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ditty — share a terminal over the web</title>
<meta name="description" content="Share a terminal over the web from a single Go binary. Read-only by default, so watching is safe and typing is a decision.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;1,7..72,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#171B24;
  --ink-deep:#0E1116;
  --ink-soft:#212734;
  --line:#2C3342;
  --paper:#ECEDE8;
  --paper-2:#F6F6F3;
  --rule:#D3D6CE;
  --pine:#2C7A6B;
  --pine-bright:#3D9C87;
  --saffron:#B8830F;
  --saffron-bright:#E0A32E;
  --rust:#B24E38;
  --muted:#5F6673;
  --sans:'Bricolage Grotesque',ui-sans-serif,system-ui,sans-serif;
  --serif:'Literata',Georgia,serif;
  --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--serif);font-size:16.5px;line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,nav,.mono,code,pre,.btn,.tag,th{font-family:var(--sans)}
code,pre,.mono{font-family:var(--mono)}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
a{color:var(--pine);text-decoration-thickness:1px;text-underline-offset:3px}

/* ---------- nav ---------- */
nav{
  display:flex;align-items:center;gap:22px;padding:20px 24px;
  max-width:1080px;margin:0 auto;font-size:14.5px;
}
.logo{display:flex;align-items:center;gap:9px;font-weight:700;font-size:20px;letter-spacing:-.03em;text-decoration:none;color:var(--ink)}
.logo .logomark{flex:0 0 auto;color:var(--ink)}
nav .grow{flex:1}
nav a{color:var(--ink);text-decoration:none}
nav a:hover{color:var(--pine)}
nav .gh{border:1px solid var(--rule);border-radius:6px;padding:5px 11px}

/* ---------- hero ---------- */
.hero{padding:34px 0 0;position:relative;overflow:hidden}
.staffbg{position:absolute;left:0;right:0;top:170px;height:120px;pointer-events:none}
.staffbg i{position:absolute;left:0;right:0;height:1px;background:var(--rule)}
.staffbg i:nth-child(1){top:0}.staffbg i:nth-child(2){top:24px}
.staffbg i:nth-child(3){top:48px}.staffbg i:nth-child(4){top:72px}
.staffbg i:nth-child(5){top:96px}
h1{
  font-size:clamp(38px,6.2vw,68px);line-height:1.02;font-weight:600;
  letter-spacing:-.045em;margin:0 0 18px;max-width:15ch;
}
.lede{font-size:19px;max-width:52ch;margin:0 0 26px;color:#2C333F}
.cta{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:34px}
.btn{
  display:inline-block;background:var(--ink);color:var(--paper-2);text-decoration:none;
  padding:10px 17px;border-radius:7px;font-weight:500;font-size:15px;border:1px solid var(--ink);
}
.btn:hover{background:#242B38}
.btn.alt{background:none;color:var(--ink);border-color:var(--rule)}
.btn.alt:hover{background:#E3E5DE}
.instant{display:flex;gap:8px;flex-wrap:wrap}
.instant .pill{
  display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:12.5px;
  color:var(--pine);background:#dceae6;border:1px solid #c3ddd6;border-radius:999px;
  padding:5px 12px 5px 10px;font-weight:500;
}
.instant .pill svg{width:13px;height:13px;flex:0 0 auto}

/* hero screencasts */
.demo{
  display:grid;grid-template-columns:1fr 1fr;gap:18px;
}
.shot{margin:0;background:var(--ink-deep);border-radius:11px;overflow:hidden;
  box-shadow:0 26px 60px -20px rgba(23,27,36,.45),0 2px 0 rgba(255,255,255,.5) inset;
  border:1px solid var(--ink);
}
.shot figcaption{
  height:38px;background:var(--ink);border-bottom:1px solid var(--line);
  display:flex;align-items:center;padding:0 13px;
  font-family:var(--sans);font-size:12.5px;color:#A6ADB9;
}
.shot img{display:block;width:100%;height:auto}
@media (max-width:800px){.demo{grid-template-columns:1fr}}
.hero-note{margin:14px 0 0;font-size:14px;color:var(--muted);max-width:60ch}

/* ---------- sections ---------- */
section{padding:70px 0}
section.tight{padding:46px 0}
h2{font-size:clamp(25px,3.4vw,34px);line-height:1.12;letter-spacing:-.035em;font-weight:600;margin:0 0 12px}
.sub{font-size:17px;color:var(--muted);max-width:56ch;margin:0 0 34px}

/* three invariants — asymmetric, not identical cards */
.invariants{border-top:2px solid var(--ink)}
.inv{
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr);gap:34px;
  padding:26px 0;border-bottom:1px solid var(--rule);align-items:start;
}
.inv h3{margin:0;font-size:21px;letter-spacing:-.03em;font-weight:600}
.inv h3 span{display:block;font-family:var(--mono);font-size:12px;color:var(--pine);font-weight:400;margin-bottom:5px}
.inv p{margin:0 0 12px}
.inv pre{
  background:var(--ink-deep);color:#D3D8DF;border-radius:8px;padding:13px 15px;
  font-size:12.5px;line-height:1.6;overflow-x:auto;margin:0;white-space:pre;
}
.inv pre .r{color:#E08070}.inv pre .d{color:#6B7484}.inv pre .g{color:#5FC9A8}.inv pre .y{color:#E5B95C}

/* recipes */
.recipes{display:flex;flex-direction:column;border-top:1px solid var(--rule)}
.recipe{
  display:grid;grid-template-columns:56px minmax(0,1fr);gap:26px;
  padding:30px 6px;border-bottom:1px solid var(--rule);
}
.recipe .num{
  font-family:var(--mono);font-size:14px;font-weight:700;padding-top:4px;
  color:var(--pine);
}
.recipe:nth-child(3n+2) .num{color:var(--saffron)}
.recipe:nth-child(3n) .num{color:var(--rust)}
.recipe .more{color:var(--pine)}
.recipe:nth-child(3n+2) .more{color:var(--saffron)}
.recipe:nth-child(3n) .more{color:var(--rust)}
.recipe h3{margin:0 0 8px;font-size:19px;font-weight:600;letter-spacing:-.025em}
.recipe p{margin:0 0 16px;font-size:14.5px;color:#333A46;line-height:1.6;max-width:62ch}
.recipe pre{
  display:block;margin:0 0 12px;background:var(--ink-deep);color:#CFE7DF;
  border-radius:8px;padding:13px 15px;font-size:12.5px;line-height:1.65;
  overflow-x:auto;white-space:pre;font-family:var(--mono);
  scrollbar-width:thin;scrollbar-color:var(--line) var(--ink-deep);
}
.recipe pre::-webkit-scrollbar{height:6px}
.recipe pre::-webkit-scrollbar-track{background:var(--ink-deep)}
.recipe pre::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}
.recipe .more{
  display:inline-flex;align-items:center;gap:5px;font-family:var(--sans);
  font-size:13.5px;font-weight:500;text-decoration:none;
}
.recipe .more svg{width:13px;height:13px;transition:transform .15s ease}
.recipe .more:hover svg{transform:translateX(3px)}
@media (max-width:640px){
  .recipe{grid-template-columns:1fr;gap:8px}
  .recipe .num{padding-top:0}
}

/* install */
.install{background:var(--ink);color:#E4E7EC;border-radius:12px;padding:30px 32px}
.install h2{color:#fff;margin-bottom:20px}
.install .cols{display:flex;flex-direction:column;gap:18px}
.install h4{margin:0 0 7px;font-family:var(--sans);font-size:13px;color:#A6ADB9;font-weight:500}
.install .cmd{position:relative}
.install pre{
  background:var(--ink-deep);border:1px solid var(--line);border-radius:7px;
  padding:11px 44px 11px 13px;margin:0;font-size:12.5px;color:#CFE7DF;
  overflow-x:auto;scrollbar-width:thin;scrollbar-color:var(--line) var(--ink-deep);
}
.install pre::-webkit-scrollbar{height:6px}
.install pre::-webkit-scrollbar-track{background:var(--ink-deep)}
.install pre::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}
.install pre::-webkit-scrollbar-thumb:hover{background:#3A4152}
.copy-btn{
  position:absolute;top:7px;right:7px;width:26px;height:26px;display:flex;
  align-items:center;justify-content:center;background:transparent;border:1px solid var(--line);
  border-radius:5px;color:#A6ADB9;cursor:pointer;padding:0;
}
.copy-btn:hover{background:var(--line);color:#E4E7EC}
.copy-btn.copied{color:var(--pine-bright);border-color:var(--pine-bright)}
.copy-btn svg{width:14px;height:14px;pointer-events:none}

/* not-doing */
.honest{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:26px}
.honest div h4{margin:0 0 6px;font-family:var(--sans);font-size:15.5px;font-weight:600}
.honest div p{margin:0;font-size:14.5px;color:#333A46}

footer{border-top:1px solid var(--rule);padding:30px 0 50px;font-size:14px;color:var(--muted)}
footer .fl{display:flex;gap:20px;flex-wrap:wrap}
footer a{color:var(--muted)}

@media (max-width:720px){
  .inv{grid-template-columns:1fr;gap:14px}
  .staffbg{display:none}
  nav .hidem{display:none}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
</head>
